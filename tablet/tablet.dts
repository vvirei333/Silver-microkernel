					compatible = "qcom,pwm-lpg";
					reg = <0xeb00>;
					reg-names = "lpg-base";
					pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x01>;
					phandle = <0x63c>;
				};

				qcom,leds@ef00 {
					compatible = "qcom,tri-led";
					reg = <0xef00>;
					phandle = <0x63d>;

