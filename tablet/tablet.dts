/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Kirby QRD";
	compatible = "qcom,kirby-qrd", "qcom,kirby", "qcom,qrd";
	qcom,msm-id = <0x22d 0x20000 0x22d 0x10000 0x241 0x20000 0x241 0x10000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	region_country = "PRC";
	qcom,board-id = <0x3000b 0x00>;

	ddr-regions {
		region2 = <0x09 0x80000000 0x01 0x80000000 0x00 0x00 0x00 0x08 0x00 0x400>;
		region1 = <0x08 0x80000000 0x01 0x00 0x00 0x00 0x00 0x02 0x00 0x400>;
		region0 = <0x00 0x80000000 0x00 0x80000000 0x00 0x00 0x00 0x00 0x00 0x400>;
	};

	memory {
		ddr_device_type = <0x08>;
		device_type = "memory";
		reg = <0x00 0x816e0000 0x00 0x320000 0x00 0x81cf5000 0x00 0xb000 0x00 0x81f20000 0x00 0x580000 0x00 0xd8800000 0x00 0x00 0x00 0xe1bb0000 0x00 0x1dc50000 0x00 0xffe00000 0x00 0x200000 0x08 0x80000000 0x00 0x2f900000 0x08 0xb0000000 0x00 0xa300000 0x09 0x80000000 0x01 0x80000000 0x08 0xc0000000 0x00 0xc0000000 0x00 0x82800000 0x00 0x2000000 0x00 0x84a00000 0x00 0x2100000 0x00 0xa1f80000 0x00 0x80000 0x00 0xa2400000 0x00 0x32a23000 0x00 0xd5100000 0x00 0x2f00000>;
	};

	chosen: chosen {
		linux,initrd-end = <0x00 0xb7fff410>;
		linux,initrd-start = <0x00 0xb757b000>;
		kaslr-seed = <0x00 0x00>;
		bootargs = "loglevel=6 kpti=0 log_buf_len=256K swiotlb=noforce kernel.panic_on_rcu_stall=1 fw_devlink.strict=1 service_locator.enable=1 rcupdate.rcu_expedited=1 rcu_nocbs=0-7 irqaffinity=0-1 cpufreq.default_governor=performance sysctl.kernel.sched_pelt_multiplier=4 no-steal-acc cgroup.memory=nokmem,nosocket printk.console_no_auto_verbose=1 kasan=off service_locator.enable=1 loop.max_part=7 no-steal-acc can.stats_timer=0 ufs_qcom.crash_on_ber=n ftrace_dump_on_oops firmware_class.path=/vendor/firmware_mnt/image,/vendor/firmware_mnt/image/kiwi,/vendor/vm-system/oemvm/boot,/vendor/vm-system/trustedvm/boot,/vendor/firmware,/vendor/firmware/wlan/qca_cld/kiwi_v2 pcie_ports=compat disable_dma32=on pci-msm-drv.pcie_sm_regs=0x1D07000,0x1040,0x1048,0x3000,0x2 slub_debug=- video=vfb:640x400,bpp=32,memsize=3072000 nosoftlockup bootconfig  fastboot_enable=1 sd_update_enable=1 hard_reset_enable=1 usb_otg_dis=0 recovery_dis=0 msm_drm.dsi_display0=qcom,mdss_dsi_kirby_nt36523_csot_dsc_vid: rootwait ro init=/init silent_boot.mode=nonsilent lenovoraw_backup_size=0 ";
		stdout-path = "/soc/qcom,qupv3_2_geni_se@8c0000/qcom,qup_uart@89c000:115200n8";
		phandle = <0x2f5>;
	};

	aliases: aliases {
		swr3 = "/soc/spf_core_platform/lpass-cdc/wsa2-macro@6AA0000/wsa2_swr_master";
		swr2 = "/soc/spf_core_platform/lpass-cdc/va-macro@6D44000/va_swr_master";
		swr1 = "/soc/spf_core_platform/lpass-cdc/rx-macro@6AC0000/rx_swr_master";
		swr0 = "/soc/spf_core_platform/lpass-cdc/wsa-macro@6B00000/wsa_swr_master";
		serial0 = "/soc/qcom,qupv3_2_geni_se@8c0000/qcom,qup_uart@89c000";
		hsuart0 = "/soc/qcom,qupv3_2_geni_se@8c0000/qcom,qup_uart@898000";
		hsuart1 = "/soc/qcom,qupv3_2_geni_se@8c0000/qcom,qup_uart@888000";
		mmc1 = "/soc/sdhci@8804000";
		ufshc1 = "/soc/ufshc@1d84000";
		phandle = <0x2f6>;
	};

	reserved_memory: reserved-memory {
