			reg = <0xd5100000 0x800000>;
		};

		psci {
			compatible = "arm,psci-1.0";
			method = "smc";

			CPU_PD0: cpu-pd0 {
				#power-domain-cells = <0x00>;
				power-domains = <0x21>;
				phandle = <0x05>;
			};

			CPU_PD1: cpu-pd1 {
				#power-domain-cells = <0x00>;
				power-domains = <0x21>;
				phandle = <0x09>;
			};

			CPU_PD2: cpu-pd2 {
				#power-domain-cells = <0x00>;
				power-domains = <0x21>;
				phandle = <0x0b>;
			};

			CPU_PD3: cpu-pd3 {
				#power-domain-cells = <0x00>;
				power-domains = <0x21>;
				phandle = <0x0d>;
			};

			CPU_PD4: cpu-pd4 {
				#power-domain-cells = <0x00>;
				power-domains = <0x21>;
				phandle = <0x0f>;
			};

			CPU_PD5: cpu-pd5 {
				#power-domain-cells = <0x00>;
				power-domains = <0x21>;
				phandle = <0x12>;
			};

			CPU_PD6: cpu-pd6 {
				#power-domain-cells = <0x00>;
				power-domains = <0x21>;
				phandle = <0x14>;
			};

			CPU_PD7: cpu-pd7 {
				#power-domain-cells = <0x00>;
				power-domains = <0x21>;
				phandle = <0x17>;
			};

			CLUSTER_PD: cluster-pd {
				#power-domain-cells = <0x00>;
				domain-idle-states = <0x22 0x23>;
				phandle = <0x21>;
			};
		};

		slimbam: bamdma@6C04000 {
			compatible = "qcom,bam-v1.7.0";
			qcom,controlled-remotely;
			reg = <0x6c04000 0x20000 0x6c8f000 0x1000>;
			reg-names = "bam", "bam_remote_mem";
			num-channels = <0x1f>;
			interrupts = <0x00 0xa4 0x04>;
			#dma-cells = <0x01>;
			qcom,ee = <0x01>;
			qcom,num-ees = <0x02>;
			phandle = <0x24>;
		};

		slim_msm: slim@6C40000 {
			compatible = "qcom,slim-ngd-v1.5.0";
			reg = <0x6c40000 0x2c000 0x6c8e000 0x1000>;
			reg-names = "ctrl", "slimbus_remote_mem";
			interrupts = <0x00 0xa3 0x04>;
			qcom,apps-ch-pipes = <0x00>;
			qcom,ea-pc = <0x490>;
			dmas = <0x24 0x03 0x24 0x04>;
			dma-names = "rx", "tx";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";
			phandle = <0x5c2>;

			ngd@1 {
				#size-cells = <0x01>;
				#address-cells = <0x01>;
				reg = <0x01>;

				slimbus: btfmslim-driver {
					phandle = <0x5c3>;
					qcom,btslimrx-channels = <0x9d 0x9e>;
					qcom,btslimtx-channels = <0x9f 0xa0>;
					qcom,btslim-address = <0x00>;
					reg = <0x01 0x00>;
					compatible = "slim217,221";
				};
			};
		};

		intc: interrupt-controller@17100000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x03>;
			interrupt-controller;
			ranges;
			#redistributor-regions = <0x01>;
			redistributor-stride = <0x00 0x40000>;
			reg = <0x17100000 0x10000 0x17180000 0x200000>;
			interrupts = <0x01 0x09 0x04>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			phandle = <0x01>;

			gic_its: msi-controller@17140000 {
				compatible = "arm,gic-v3-its";
