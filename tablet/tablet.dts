					proxy-supply = <0x33>;

					pm_v8_s3_level: S3I_LEVEL: VDD_MXA_LEVEL: regulator-pm-v8-s3-level {
						regulator-name = "pm_v8_s3_level";
						qcom,set = <0x03>;
