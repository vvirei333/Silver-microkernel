		cam_rsc: rsc@add9000 {
			label = "cam_rsc";
			compatible = "qcom,rpmh-rsc";
			reg = <0xadd4000 0x1000 0xadd5000 0x1000 0xadd6000 0x1000>;
			reg-names = "drv-0", "drv-1", "drv-2";
			qcom,drv-count = <0x03>;
			qcom,hw-channel;
			interrupts = <0x00 0x170 0x04 0x00 0x171 0x04 0x00 0x172 0x04>;
			clocks = <0x3a 0x3d>;
			phandle = <0x3bf>;

			cam_rsc_drv0: drv@0 {
				qcom,drv-id = <0x00>;
				qcom,tcs-offset = <0x520>;
				phandle = <0x3c0>;

				channel@0 {
					qcom,tcs-config = <0x02 0x00 0x01 0x01 0x00 0x01 0x03 0x00 0x04 0x00>;
				};

				channel@1 {
					qcom,tcs-config = <0x02 0x00 0x01 0x01 0x00 0x01 0x03 0x00 0x04 0x00>;
				};

				cam_bcm_voter0: bcm_voter {
					compatible = "qcom,bcm-voter";
					qcom,no-amc;
					phandle = <0x29>;
				};
			};

			cam_rsc_drv1: drv@1 {
				qcom,drv-id = <0x01>;
				qcom,tcs-offset = <0x520>;
				phandle = <0x3c1>;

				channel@0 {
					qcom,tcs-config = <0x02 0x00 0x01 0x01 0x00 0x01 0x03 0x00 0x04 0x00>;
				};

				channel@1 {
					qcom,tcs-config = <0x02 0x00 0x01 0x01 0x00 0x01 0x03 0x00 0x04 0x00>;
				};

				cam_bcm_voter1: bcm_voter {
					compatible = "qcom,bcm-voter";
					qcom,no-amc;
					phandle = <0x2a>;
				};
			};

